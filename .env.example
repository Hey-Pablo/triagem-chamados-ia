# Configurações do n8n
# Copie este arquivo para .env e preencha os valores

# Chave de criptografia do n8n (gere 32 caracteres aleatórios)
N8N_ENCRYPTION_KEY=your_32_character_encryption_key_here

# Modelo de linguagem para classificação
# Opções: claude-opus-5-5, claude-haiku-5-5
LLM_MODEL=claude-opus-5-5

# Threshold de confiança para revisão humana (0.0 a 1.0)
CONFIDENCE_THRESHOLD=0.70

# Token do bot do Telegram para notificações
# Crie um bot pelo @BotFather e adicione ao grupo de suporte
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# ID do chat do grupo no Telegram
TELEGRAM_CHAT_ID=your_telegram_group_id

# API key do Claude (para uso com Codex CLI ou SDK)
ANTHROPIC_API_KEY=your_claude_api_key

# Endpoint do webhook n8n (usado pelo formulário)
WEBHOOK_URL=http://localhost:5678/webhook/triagem-chamados