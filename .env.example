# Configurações do n8n
# Copie este arquivo para .env e preencha os valores

# =============================================================================
# Banco de Dados PostgreSQL
# =============================================================================
POSTGRES_USER=n8n_user
POSTGRES_PASSWORD=coloque-sua-senha-aqui
POSTGRES_DATABASE=n8n
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=coloque-sua-senha-aqui

# Chave de criptografia do n8n (gere 32 caracteres aleatórios)
N8N_ENCRYPTION_KEY=coloque-sua-chave-aqui-min-32-caracteres

# =============================================================================
# API do Modelo de Linguagem
# =============================================================================
# URL da API do provedor de IA (Claude, OpenAI, etc.)
LLM_API_URL=https://api.anthropic.com/v1/messages

# Modelo de linguagem para classificação
# Opções: claude-opus-5-5, claude-haiku-5-5
LLM_MODEL=claude-opus-5-5

# Chave de API do provedor (Claude, OpenAI, etc.)
LLM_API_KEY=coloque-sua-chave-api-aqui

# Máximo de tentativas de retry em caso de falha
LLM_MAX_RETRIES=3

# =============================================================================
# Classificação
# =============================================================================
# Threshold de confiança para revisão humana (0.0 a 1.0)
# Baixo de 0.70 = revisão humana obrigatória
CONFIDENCE_THRESHOLD=0.70

# =============================================================================
# Telegram - Notificações
# =============================================================================
# Token do bot do Telegram para notificações
# Crie um bot pelo @BotFather e adicione ao grupo de suporte
TELEGRAM_BOT_TOKEN=coloque-seu-token-bot-aqui

# ID do chat do grupo no Telegram
TELEGRAM_CHAT_ID=coloque-seu-id-telegram-aqui

# =============================================================================
# Webhook
# =============================================================================
# Endpoint do webhook n8n (usado pelo formulário)
WEBHOOK_URL=http://localhost:5678/webhook/triagem-chamados